# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# JWT
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Firebase — FCM (push notifications)
# Paste the full JSON of google-credentials.json as a single-line string
FIREBASE_FCM_JSON=''

# Firebase — Firestore
# Paste the full JSON of firebase-horus-main.json as a single-line string
FIREBASE_FIRESTORE_JSON=''

# Horus AI (Railway)
HORUS_API_URL=https://ia-personalizada-horus-production.up.railway.app
HORUS_API_SECRET=""

# Horus Braslet (Vercel)
BRASLET_URL=https://horus-web-psi.vercel.app

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Server
PORT=3000
NODE_ENV=production
