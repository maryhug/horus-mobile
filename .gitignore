# Crea el tuyo con: echo "EXPO_PUBLIC_API_URL=http://localhost:3000/api" > .env
.env
.env*.local

# TypeScript
*.tsbuildinfo

# Claude Code — configuracion local del editor
.claude/

# Prisma generated client — regenerar con: cd server && npx prisma generate
server/src/generated/

.idea/